			<string>Layouts for folded, unfolded portrait, and unfolded half-screen use. Classic: standard bottom tabs. Native: floating glass tabs with a right-side rail where supported. Fullscreen: standard bottom tabs with full-width content. Tab placement adapts to the window. Fully close and reopen TikTok after changing modes.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Layout Mode</string>
			<key>Key</key>
			<string>TCLCover.layout</string>
			<key>DefaultValue</key>
			<integer>0</integer>
			<key>Titles</key>
			<array>
				<string>Classic</string>
				<string>Native</string>
				<string>Fullscreen</string>
			</array>
			<key>Values</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>FooterText</key>
			<string>Advanced experiments apply across display configurations.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSChildPaneSpecifier</string>
			<key>Title</key>
			<string>Advanced</string>
			<key>File</key>
			<string>Advanced</string>
		</dict>
